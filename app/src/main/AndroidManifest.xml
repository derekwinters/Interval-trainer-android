<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SVC-010: the mediaPlayback foreground-service type's own manifest permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- SVC-011: the wake lock the service holds for as long as a workout is running or paused. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- CUE-020, CUE-024: every cue vibrates, and mute never suppresses it. Protection level is
         normal, so this is granted at install with no runtime prompt and nothing asks for it. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The notification's own runtime permission (SVC-020–024). Declaring it here is what makes
         it requestable at all; the first-run request flow itself is SVC-030–033, built in #84 as
         MainActivity.kt's `first_run` route, the app's one call site for it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.IntervalTrainer">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SVC-010, SVC-041: mediaPlayback type; not exported, since only this app ever starts
             it; android:stopWithTask is left at the platform default, false, so removing the
             task from recents does not stop it (SVC-041). -->
        <service
            android:name=".service.WorkoutService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
